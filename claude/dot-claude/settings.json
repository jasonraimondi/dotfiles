{
  "cleanupPeriodDays": 60,
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Skill(creating-a-plan)",
      "Skill(implementing-a-plan)"
    ],
    "ask": ["Bash(rm:*)"],
    "deny": ["Bash(git push*)", "Bash(git push --force*)"]
  },
  "enabledPlugins": {
    "linear@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "autoUpdates": true
}
