{
  "cleanupPeriodDays": 365,
  "permissions": {
    "allow": [],
    "deny": [
      "EnterPlanMode",
      "ExitPlanMode",
      "DesignSync",
      "NotebookEdit",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup",
      "AskUserQuestion",
      "CronCreate",
      "CronDelete",
      "CronList"
    ],
    "ask": [
      "Bash(./node_modules/.bin/igai deploy *)",
      "Bash(./node_modules/.bin/igbe deploy *)",
      "Bash(./node_modules/.bin/igext deploy *)",
      "Bash(./node_modules/.bin/igfe deploy *)",
      "Bash(./node_modules/.bin/igp deploy *)",
      "Bash(./node_modules/.bin/igrp container-deploy *)",
      "Bash(./node_modules/.bin/igrp deploy *)",
      "Bash(./node_modules/.bin/igrp force-deploy *)",
      "Bash(./node_modules/.bin/igrp infra-deploy *)",
      "Bash(./node_modules/.bin/igrp push *)",
      "Bash(igai deploy *)",
      "Bash(igbe deploy *)",
      "Bash(igext deploy *)",
      "Bash(igfe deploy *)",
      "Bash(igp deploy *)",
      "Bash(igrp container-deploy *)",
      "Bash(igrp deploy *)",
      "Bash(igrp force-deploy *)",
      "Bash(igrp infra-deploy *)",
      "Bash(igrp push *)",
      "Bash(pnpm deploy:backend *)",
      "Bash(pnpm deploy:frontend *)",
      "Bash(pnpm exec igai deploy *)",
      "Bash(pnpm exec igbe deploy *)",
      "Bash(pnpm exec igext deploy *)",
      "Bash(pnpm exec igfe deploy *)",
      "Bash(pnpm exec igp deploy *)",
      "Bash(pnpm exec igrp container-deploy *)",
      "Bash(pnpm exec igrp deploy *)",
      "Bash(pnpm exec igrp force-deploy *)",
      "Bash(pnpm exec igrp infra-deploy *)",
      "Bash(pnpm exec igrp push *)",
      "Bash(pnpm igfe-deploy *)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/herdr-tab-title.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "disableRemoteControl": true,
  "enabledPlugins": {
    "figma@claude-plugins-official": true,
    "typesafe@typesafe-ai": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "slack-uploader@intelligems-tools": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "typesafe-ai": {
      "source": {
        "source": "github",
        "repo": "typesafe-ai/skills"
      }
    },
    "intelligems-tools": {
      "source": {
        "source": "github",
        "repo": "intelligems-io/slack-uploader"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5-1": {
      "autoCompactWindow": 500000
    },
    "claude-fable-5-2": {
      "effortLevel": "high"
    }
  },
  "autoMemoryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "idleCompaction": false,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: not queryable here — assume private per shipped-default heuristic (github.com/jasonraimondi/dotfiles; no public signal found)",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: macos (default branch per repo facts); protected-branch/ruleset status not queryable here",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Source control**: The trusted repo (github.com:jasonraimondi/dotfiles.git) and its remote only — no additional orgs configured",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries prod or production as a whole word or name segment (hyphen/underscore/dot-delimited)",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries prod or production as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development",
      "**Trusted repo**: ~/dotfiles (github.com:jasonraimondi/dotfiles.git) — public on GitHub, so every commit and push publishes its contents; per CLAUDE.md, routine commits go directly to macos in this repo unless already on another branch",
      "**Org-specific CLIs**: None configured",
      "No additional routine-under-<user>/ prefix qualifiers found"
    ]
  },
  "__disableClaudeAiConnectors": true,
  "__disableWorkflows": true,
  "disableArtifacts": true
}
