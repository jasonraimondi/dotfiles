#!/usr/bin/env zsh

if ! command -v "immich-go" &> /dev/null; then
    echo "Error: Required command 'immich-go' not found"
    exit 1
fi

if [ -z "$IMMICH_SERVER" ]; then
    echo "IMMICH_SERVER is NOT set or is empty"
    exit 1
fi

# Search desktop for folders named 10*MSDCF*
DESKTOP="$HOME/Desktop"
LOGROOT="/tmp/camera-sync"

echo "Searching desktop: $DESKTOP"
echo


# Find and process matching folders
for folder in "$DESKTOP"/10*MSDCF*; do
    # Check if folder exists (in case no matches found)
    [ -d "$folder" ] || continue

    echo "Processing: $(basename "$folder")"

    # Create subdirectories
    mkdir -p "$folder/raw" "$folder/jpg"

    # Move .arw and .xmp files to raw/
    find "$folder" -maxdepth 1 -type f \( -iname "*.arw" -o -iname "*.xmp" \) -exec mv {} "$folder/raw/" \;

    # Move .jpg files to jpg/
    find "$folder" -maxdepth 1 -type f \( -iname "*.jpg" -o -iname "*.jpeg" \) -exec mv {} "$folder/jpg/" \;

    echo "  ✓ Files organized"
    echo

done

NAS_HOST="${NAS_SERVER%%:*}"
NAS_DIR="${NAS_SERVER#*:}"

# Cameras reuse file numbers, so a name already on the NAS can belong to a different photo.
# Those local photos (and their sidecars) get a free name so they are added, not skipped.
rename_conflicts() {
    local dir="$1"
    local -a conflicts taken
    conflicts=(${(f)"$(rsync -ani --existing -e ssh "$dir/" "$NAS_SERVER" | awk '/^>f/ && tolower($2) ~ /\.arw$/ {print $2}')"})
    (( ${#conflicts} )) || return 0

    taken=(${(f)"$(ssh "$NAS_HOST" "ls -A '$NAS_DIR'")"} "$dir"/*(:t))
    local file stem n src
    for file in $conflicts; do
        stem="${file:r}"
        n=1
        while (( ${taken[(I)${stem}_$n.*]} )); do (( n++ )); done
        for src in "$dir/$stem".*; do
            mv -n "$src" "$dir/${stem}_$n.${src:e}"
            taken+=("${stem}_$n.${src:e}")
        done
        echo "  Renamed $stem.* -> ${stem}_$n.* (name already used on NAS)"
    done
}

for folder in "$DESKTOP"/10*MSDCF*; do
    [ -d "$folder" ] || continue
    echo "$folder/raw/"
    echo "to"
    echo "$NAS_SERVER"
    rename_conflicts "$folder/raw"
    rsync -av --ignore-existing --partial-dir=.rsync-partial --progress -e ssh "$folder/raw/" $NAS_SERVER
done

# echo
# read -q "REPLY?Upload to Immich? [y/N] " || { echo; echo "Skipping upload."; exit 0; }
# echo

# mkdir -p "$LOGROOT"

# for folder in "$DESKTOP"/10*MSDCF*; do
#     [ -d "$folder" ] || continue

#     echo "Uploading: $(basename "$folder")"

#     immich-go upload from-folder --server "$IMMICH_SERVER" --log-file="$LOGROOT/jpg.log" --api-key "$IMMICH_API_KEY_SHARED" --pause-immich-jobs=FALSE "$folder/jpg/"
#     immich-go upload from-folder --server "$IMMICH_SERVER" --log-file="$LOGROOT/raw.log" --api-key "$IMMICH_API_KEY_SONY" --pause-immich-jobs=FALSE "$folder/raw/"

#     echo "  ✓ Upload complete"
#     echo
# done

# echo "Done!"
