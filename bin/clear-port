#!/bin/sh

# Kills the process running on the provided port
# source: https://raw.githubusercontent.com/thoughtbot/dotfiles/main/bin/clear-port
#
# clear-port 3000

if [ -n "$1" ]; then
  if port_num="$(lsof -ti4TCP:"$1")"; then
    printf '%s\n' "$port_num" | xargs kill
  fi
else
  echo >&2 Usage: clear-port port-number
  exit 1
fi
