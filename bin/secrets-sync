#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
tpl="$root/zsh/dot-zsh/00-secrets.tpl"
out="$root/zsh/dot-zsh/00-SECRETS.zsh"

[[ -r "$tpl" ]] || { echo "secrets-sync: template not found: $tpl" >&2; exit 1; }

if [[ "${1:-}" == "--check" ]]; then
  status=0
  while IFS= read -r ref; do
    if ! op read "$ref" >/dev/null 2>&1; then
      echo "secrets-sync: cannot resolve $ref" >&2
      status=1
    fi
  done < <(grep -oE 'op://[^"]+' "$tpl")
  exit "$status"
fi

if [[ $# -gt 0 ]]; then
  echo "usage: secrets-sync [--check]" >&2
  exit 2
fi

tmp="$(mktemp "$out.XXXXXX")"
trap 'rm -f "$tmp"' EXIT
op inject -f -i "$tpl" -o "$tmp"
chmod 600 "$tmp"
mv "$tmp" "$out"
