#!/usr/bin/env bash
set -euo pipefail

export OP_ACCOUNT="${OP_ACCOUNT:-raimondi.1password.com}"

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
tpl="$root/zsh/dot-zsh/00-secrets.tpl"
out="$root/zsh/dot-zsh/00-SECRETS.zsh"

[[ -r "$tpl" ]] || { echo "secrets-sync: template not found: $tpl" >&2; exit 1; }

validate_refs() {
  local ref value status=0
  while IFS= read -r ref; do
    if ! value="$(op read "$ref" 2>/dev/null)"; then
      echo "secrets-sync: cannot resolve $ref" >&2
      status=1
    elif [[ "$value" == *"'"* ]]; then
      echo "secrets-sync: value of $ref contains a single quote, which the single-quoted template cannot hold" >&2
      status=1
    fi
  done < <(grep -oE "op://[^']+" "$tpl")
  return "$status"
}

if [[ "${1:-}" == "--check" ]]; then
  validate_refs
  exit
fi

if [[ $# -gt 0 ]]; then
  echo "usage: secrets-sync [--check]" >&2
  exit 2
fi

validate_refs

tmp="$(mktemp "$out.XXXXXX")"
trap 'rm -f "$tmp"' EXIT
op inject -f -i "$tpl" -o "$tmp"
chmod 600 "$tmp"
mv "$tmp" "$out"
