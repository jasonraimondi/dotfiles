#!/usr/bin/env bash

set -euo pipefail

for arg in "$@"; do
    [[ "$arg" == "--debug" || "$arg" == "-d" ]] && set -x && break
done

SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_SOURCE" ]]; do
    SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)"
    SCRIPT_SOURCE="$(readlink "$SCRIPT_SOURCE")"
    [[ "$SCRIPT_SOURCE" != /* ]] && SCRIPT_SOURCE="$SCRIPT_DIR/$SCRIPT_SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)"
readonly SCRIPT_DIR
DOTFILES_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
readonly DOTFILES_ROOT

DEFAULT_PROMPT=""
DEFAULT_PROMPT_SOURCE=""
PROMPT=""
ACTIVE_RUNNER=""
SCOPE=""
PHASE_NUMBER=""

usage() {
    cat <<EOF
Usage: ralph [OPTIONS] [COMMAND]

Commands:
  once                Run single iteration
  init                Create PROMPT.md with default prompt
  task [description]  Run next pending task, or one matching description
  phase <N>           Run pending phase N tasks in parallel (one agent per task, git worktrees)

Options:
  -d, --debug                 Enable shell tracing (set -x)
  -n, --max-iterations <N>    Run up to N iterations (default: 20)
  -r, --runner <RUNNER>       Runner to use: auto|claude|pi (default: auto)
  -h, --help                  Show this help message

Examples:
  ralph                       Run with default 20 iterations (auto runner)
  ralph --runner pi           Force pi runner
  ralph --runner claude once  Force claude runner, single iteration
  ralph -n 5                  Run up to 5 iterations
  ralph --max-iterations=10   Run up to 10 iterations
  ralph task                   Run the next pending task
  ralph task "add login"      Run only the task matching "add login"
  ralph phase 1               Spawn parallel agents for phase 1 pending tasks
  ralph phase 2 --runner pi   Run phase 2 sequentially (pi fallback)

Default Prompt Search Order:
  1. $DOTFILES_ROOT/config/skillshare/skills/ralph/SKILL.md
  2. $DOTFILES_ROOT/claude/dot-claude/commands/ralph.md (legacy)
  3. ~/.config/skillshare/skills/ralph/SKILL.md
  4. ~/.claude/commands/ralph.md

Runner Notes:
  - claude: requires Claude Code CLI and permissions for git add/commit
  - pi: requires pi CLI with bash/edit/write tools enabled
  - phase parallel mode requires claude runner, yq, and jq
EOF
}

die() {
    printf '%s\n' "$1" >&2
    exit 1
}

strip_frontmatter() {
    local path="$1"
    awk '
        NR == 1 && $0 == "---" { in_frontmatter = 1; next }
        in_frontmatter && $0 == "---" { in_frontmatter = 0; next }
        !in_frontmatter { print }
    ' "$path"
}

build_scope() {
    local scope_type="$1"
    local scope_value="${2:-}"

    case "$scope_type" in
        task)
            if [[ -n "$scope_value" ]]; then
                SCOPE="$(cat <<SCOPE_EOF

## Scope Constraint — Single Task

You MUST only work on the task whose description contains: "$scope_value"

Search through all phase files in plans/prd/ to find the matching task. If the matching task is already done, blocked, or not found, output <promise>COMPLETE</promise> and stop.
SCOPE_EOF
)"
            else
                SCOPE="$(cat <<'SCOPE_EOF'

## Scope Constraint — Next Task

You MUST only work on the single next pending task. Find the first task across all phase files in plans/prd/ (in phase order, then task order) that is not done and not blocked. Work on that one task only. When it is done, output <promise>COMPLETE</promise> and stop.
SCOPE_EOF
)"
            fi
            ;;
        phase)
            local phase_file
            phase_file="$(printf './plans/prd/phase-%02d.yaml' "$scope_value")"
            [[ -f "$phase_file" ]] || die "Phase file not found: $phase_file"
            SCOPE="$(cat <<SCOPE_EOF

## Scope Constraint — Phase $scope_value

You MUST only work on tasks from $phase_file. Use forever-mode behavior: loop through all tasks in this phase file. Ignore tasks from other phases. When all tasks in this phase are done, output <promise>COMPLETE</promise> and stop.
SCOPE_EOF
)"
            ;;
    esac
}

resolve_default_prompt_source() {
    local candidates=(
        "$DOTFILES_ROOT/config/skillshare/skills/ralph/SKILL.md"
        "$DOTFILES_ROOT/claude/dot-claude/commands/ralph.md"
        "$HOME/.config/skillshare/skills/ralph/SKILL.md"
        "$HOME/.claude/commands/ralph.md"
    )
    local candidate

    for candidate in "${candidates[@]}"; do
        if [[ -f "$candidate" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done

    return 1
}

load_default_prompt() {
    local source
    source="$(resolve_default_prompt_source)" || die "Could not find a default Ralph prompt source"

    DEFAULT_PROMPT_SOURCE="$source"
    DEFAULT_PROMPT="$(strip_frontmatter "$DEFAULT_PROMPT_SOURCE")"

    [[ -n "$DEFAULT_PROMPT" ]] || die "Default prompt is empty: $DEFAULT_PROMPT_SOURCE"
}

load_prompt() {
    local prompt_path="$PWD/PROMPT.md"
    if [[ -f "$prompt_path" ]]; then
        PROMPT="$(strip_frontmatter "$prompt_path")"
    else
        printf '%s not found, using default prompt from %s\n' "$prompt_path" "$DEFAULT_PROMPT_SOURCE" >&2
        PROMPT="$DEFAULT_PROMPT"
    fi
}

require_plan_files() {
    local required_file="./plans/prd.yaml"
    local optional_files=(
        "./plans/progress.md"
        "./plans/research.md"
    )
    local missing_optional_files=()
    local file

    if [[ ! -f "$required_file" ]]; then
        {
            printf 'Missing required Ralph plan file in %s:\n' "$PWD"
            printf '  - %s\n' "$required_file"
            printf 'Create the missing file before running Ralph.\n'
        } >&2
        exit 1
    fi

    for file in "${optional_files[@]}"; do
        [[ -f "$file" ]] || missing_optional_files+=("$file")
    done

    if (( ${#missing_optional_files[@]} > 0 )); then
        {
            printf 'Warning: optional Ralph context files are missing:\n'
            for file in "${missing_optional_files[@]}"; do
                printf '  - %s\n' "$file"
            done
            printf 'Continuing without them.\n'
        } >&2
    fi
}

validate_runner_value() {
    case "$1" in
        auto|claude|pi) ;;
        *) die "Invalid runner: $1 (expected: auto, claude, pi)" ;;
    esac
}

resolve_runner() {
    local requested_runner="$1"

    validate_runner_value "$requested_runner"

    case "$requested_runner" in
        auto)
            if command -v claude >/dev/null 2>&1; then
                ACTIVE_RUNNER="claude"
            elif command -v pi >/dev/null 2>&1; then
                ACTIVE_RUNNER="pi"
            else
                die "Neither claude nor pi CLI found in PATH"
            fi
            ;;
        claude)
            command -v claude >/dev/null 2>&1 || die "claude CLI not found in PATH"
            ACTIVE_RUNNER="claude"
            ;;
        pi)
            command -v pi >/dev/null 2>&1 || die "pi CLI not found in PATH"
            ACTIVE_RUNNER="pi"
            ;;
    esac
}

run_prompt() {
    case "$ACTIVE_RUNNER" in
        claude)
            claude --permission-mode acceptEdits -p "$PROMPT"
            ;;
        pi)
            pi -p "$PROMPT"
            ;;
        *)
            die "Runner not resolved"
            ;;
    esac
}

run_iteration() {
    local iteration="${1:-}"
    local rc=0
    local result

    result="$(run_prompt 2>&1)" || rc=$?

    printf '%s\n' "$result"

    if (( rc != 0 )); then
        return "$rc"
    fi

    if [[ "$result" == *"<promise>COMPLETE</promise>"* ]]; then
        if [[ -n "$iteration" ]]; then
            echo "PRD complete after $iteration iterations."
        else
            echo "PRD complete."
        fi
        return 100
    fi

    return 0
}

require_yq() {
    if ! command -v yq >/dev/null 2>&1; then
        die "yq is required for parallel phase execution. Install with: brew install yq"
    fi
    if ! command -v jq >/dev/null 2>&1; then
        die "jq is required for parallel phase execution. Install with: brew install jq"
    fi
}

extract_pending_tasks() {
    local phase_file="$1"
    yq -o=json '.tasks' "$phase_file" | jq -r '.[] | select(.status == "pending") | .description'
}

create_task_worktree() {
    local phase_num="$1"
    local task_index="$2"
    local current_branch
    current_branch="$(git rev-parse --abbrev-ref HEAD)"
    local branch_name="ralph/phase-${phase_num}/task-${task_index}"
    local worktree_dir=".ralph-work/task-${task_index}"

    git branch "$branch_name" "$current_branch" 2>/dev/null || true
    git worktree add "$worktree_dir" "$branch_name" --quiet
    printf '%s\n' "$worktree_dir"
}

spawn_task_agent() {
    local worktree_dir="$1"
    local task_description="$2"
    local task_index="$3"
    local log_file=".ralph-work/task-${task_index}.log"
    local full_prompt

    full_prompt="${PROMPT}

## Scope Constraint — Single Task

You MUST only work on the task whose description is: \"${task_description}\"
Search through all phase files in plans/prd/ to find this task. Work on it, commit, then output <promise>COMPLETE</promise>."

    (
        cd "$worktree_dir"
        env -u CLAUDECODE claude \
            --print \
            --session-id "$(uuidgen)" \
            --no-session-persistence \
            --permission-mode acceptEdits \
            -p "$full_prompt"
    ) > "$log_file" 2>&1 &
    printf '%d\n' $!
}

merge_task_results() {
    local phase_num="$1"
    local task_count="$2"
    local succeeded=0
    local failed=0
    local conflicts=0

    for ((t=1; t<=task_count; t++)); do
        local branch_name="ralph/phase-${phase_num}/task-${t}"
        local log_file=".ralph-work/task-${t}.log"

        if [[ -f "$log_file" ]] && grep -q '<promise>COMPLETE</promise>' "$log_file"; then
            if git merge --no-edit "$branch_name" 2>/dev/null; then
                printf 'Task %d: merged successfully\n' "$t"
                ((succeeded++))
            else
                printf 'Task %d: merge conflict — resolve manually (branch: %s)\n' "$t" "$branch_name" >&2
                git merge --abort 2>/dev/null || true
                printf '%d\n' "$t" >> .ralph-work/conflict-tasks
                ((conflicts++))
            fi
        else
            printf 'Task %d: agent did not signal completion\n' "$t" >&2
            ((failed++))
        fi
    done

    printf '\n=== Phase %d Results ===\n' "$phase_num"
    printf 'Succeeded: %d | Failed: %d | Conflicts: %d\n' "$succeeded" "$failed" "$conflicts"
}

cleanup_worktrees() {
    local phase_num="$1"
    local task_count="$2"

    local conflict_tasks=""
    [[ -f .ralph-work/conflict-tasks ]] && conflict_tasks="$(cat .ralph-work/conflict-tasks)"

    for ((t=1; t<=task_count; t++)); do
        local worktree_dir=".ralph-work/task-${t}"
        local branch_name="ralph/phase-${phase_num}/task-${t}"
        git worktree remove "$worktree_dir" 2>/dev/null || true
        if printf '%s\n' "$conflict_tasks" | grep -qx "$t"; then
            printf 'Keeping branch %s (has unmerged changes)\n' "$branch_name" >&2
        else
            git branch -D "$branch_name" 2>/dev/null || true
        fi
    done

    rmdir .ralph-work 2>/dev/null || true
}

run_phase_parallel() {
    local phase_num="$1"
    local phase_file
    phase_file="$(printf './plans/prd/phase-%02d.yaml' "$phase_num")"

    [[ -f "$phase_file" ]] || die "Phase file not found: $phase_file"
    require_yq

    local tasks=()
    while IFS= read -r line; do
        [[ -n "$line" ]] && tasks+=("$line")
    done < <(extract_pending_tasks "$phase_file")

    local task_count=${#tasks[@]}

    if (( task_count == 0 )); then
        printf 'All tasks in phase %d are done.\n' "$phase_num"
        return 0
    fi

    printf 'Phase %d: spawning %d parallel agent(s)\n' "$phase_num" "$task_count"
    mkdir -p .ralph-work

    # Trap for cleanup on exit/error/interrupt
    trap "cleanup_worktrees '$phase_num' '$task_count'" EXIT INT TERM

    local pids=()
    for ((t=1; t<=task_count; t++)); do
        local description="${tasks[$((t-1))]}"
        printf 'Task %d: %s\n' "$t" "$description"

        local worktree_dir
        worktree_dir="$(create_task_worktree "$phase_num" "$t")"

        local pid
        pid="$(spawn_task_agent "$worktree_dir" "$description" "$t")"
        pids+=("$pid")
        printf 'Task %d: agent PID %d in %s\n' "$t" "$pid" "$worktree_dir"
    done

    printf '\nWaiting for %d agent(s) to complete...\n' "$task_count"
    local wait_failed=0
    for pid in "${pids[@]}"; do
        wait "$pid" 2>/dev/null || ((wait_failed++))
    done

    printf '\nAll agents finished. Merging results...\n'
    merge_task_results "$phase_num" "$task_count"
    # Cleanup happens via trap
}

main() {
    local max_iterations=20
    local cmd=""
    local runner="auto"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -d|--debug)
                shift  # Already handled early, just consume
                ;;
            -h|--help|help)
                usage
                exit 0
                ;;
            -n|--max-iterations)
                [[ -n "${2:-}" ]] || die "Missing argument for $1"
                max_iterations="$2"
                shift 2
                ;;
            --max-iterations=*)
                max_iterations="${1#*=}"
                shift
                ;;
            -r|--runner)
                [[ -n "${2:-}" ]] || die "Missing argument for $1"
                runner="$2"
                shift 2
                ;;
            --runner=*)
                runner="${1#*=}"
                shift
                ;;
            task)
                cmd="task"
                if [[ -n "${2:-}" && "${2:0:1}" != "-" ]]; then
                    build_scope "task" "$2"
                    shift 2
                else
                    build_scope "task"
                    shift
                fi
                ;;
            phase)
                [[ -n "${2:-}" ]] || die "Missing phase number for $1"
                [[ "$2" =~ ^[1-9][0-9]*$ ]] || die "Invalid phase number: $2"
                cmd="phase"
                PHASE_NUMBER="$2"
                shift 2
                ;;
            init|once)
                cmd="$1"
                shift
                ;;
            *)
                die "Unknown option: $1"
                ;;
        esac
    done

    # Validate max_iterations is a positive integer
    [[ "$max_iterations" =~ ^[1-9][0-9]*$ ]] || die "Invalid max-iterations: $max_iterations"
    validate_runner_value "$runner"

    load_default_prompt

    if [[ "$cmd" == "init" ]]; then
        [[ -f "$PWD/PROMPT.md" ]] && die "PROMPT.md already exists in $PWD"
        echo "Creating PROMPT.md from $DEFAULT_PROMPT_SOURCE"
        printf '%s\n' "$DEFAULT_PROMPT" > PROMPT.md
        exit 0
    fi

    require_plan_files
    resolve_runner "$runner"
    printf 'Using runner: %s\n' "$ACTIVE_RUNNER" >&2
    load_prompt

    # Phase command takes a separate parallel path
    if [[ "$cmd" == "phase" ]]; then
        if [[ "$ACTIVE_RUNNER" != "claude" ]]; then
            printf 'Warning: parallel phase execution requires claude runner. Falling back to sequential.\n' >&2
            build_scope "phase" "$PHASE_NUMBER"
            PROMPT+="$SCOPE"
            for ((i=1; i<=max_iterations; i++)); do
                printf '=== Iteration %d/%d ===\n' "$i" "$max_iterations"
                local rc=0
                run_iteration "$i" || rc=$?
                (( rc == 100 )) && exit 0
                (( rc != 0 )) && exit "$rc"
            done
            echo "Max iterations reached."
            exit 0
        fi
        run_phase_parallel "$PHASE_NUMBER"
        exit 0
    fi

    if [[ -n "$SCOPE" ]]; then
        PROMPT+="$SCOPE"
    fi

    if [[ "$cmd" == "once" || "$cmd" == "task" ]]; then
        local rc=0
        run_iteration "1" || rc=$?
        (( rc == 100 )) && exit 0
        exit "$rc"
    fi

    for ((i=1; i<=max_iterations; i++)); do
        printf '=== Iteration %d/%d ===\n' "$i" "$max_iterations"
        local rc=0
        run_iteration "$i" || rc=$?
        (( rc == 100 )) && exit 0
        (( rc != 0 )) && exit "$rc"
    done
    echo "Max iterations reached."
}

main "$@"
