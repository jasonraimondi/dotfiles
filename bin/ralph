#!/usr/bin/env bash

set -euo pipefail

for arg in "$@"; do
    [[ "$arg" == "--debug" || "$arg" == "-d" ]] && set -x && break
done

readonly SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
readonly DEFAULT_PROMPT="$(sed '1{/^---$/!q;};1,/^---$/d' "$SCRIPT_DIR/../claude/dot-claude/commands/ralph.md")"

usage() {
    cat <<EOF
Usage: ralph [OPTIONS] [COMMAND]

Commands:
  once    Run single iteration
  init    Create PROMPT.md with default prompt

Options:
  -d, --debug                 Enable shell tracing (set -x)
  -n, --max-iterations <N>    Run up to N iterations (default: 20)
  -h, --help                  Show this help message

Examples:
  ralph                       Run with default 20 iterations
  ralph once                  Run a single iteration
  ralph -n 5                  Run up to 5 iterations
  ralph --max-iterations=10   Run up to 10 iterations

Required Claude Permissions:
  The following permissions must be allowed in Claude settings:
    Bash(git add:*)
    Bash(git commit:*)
EOF
}

die() {
    printf '%s\n' "$1" >&2
    exit 1
}

load_prompt() {
    local prompt_path="$PWD/PROMPT.md"
    if [[ -f "$prompt_path" ]]; then
        PROMPT="$(<"$prompt_path")"
    else
        printf '%s not found, using default prompt\n' "$prompt_path" >&2
        PROMPT="$DEFAULT_PROMPT"
    fi
}

run_iteration() {
    RESULT=$(claude --permission-mode acceptEdits -p "$PROMPT")
    # RESULT=$(opencode run "$PROMPT");

    echo "$RESULT"

    if [[ "$RESULT" == *"<promise>COMPLETE</promise>"* ]]; then
        echo "PRD complete after $i iterations."
        exit 0
    fi
}

main() {
    local max_iterations=20
    local cmd=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -d|--debug)
                shift  # Already handled early, just consume
                ;;
            -h|--help|help)
                usage
                exit 0
                ;;
            -n|--max-iterations)
                [[ -n "${2:-}" ]] || die "Missing argument for $1"
                max_iterations="$2"
                shift 2
                ;;
            --max-iterations=*)
                max_iterations="${1#*=}"
                shift
                ;;
            init|once)
                cmd="$1"
                shift
                ;;
            *)
                die "Unknown option: $1"
                ;;
        esac
    done

    # Validate max_iterations is a positive integer
    [[ "$max_iterations" =~ ^[1-9][0-9]*$ ]] || die "Invalid max-iterations: $max_iterations"

    case "$cmd" in
        init)
            echo "Creating PROMPT.md"
            printf '%s\n' "$DEFAULT_PROMPT" > PROMPT.md
            exit 0
            ;;
        once)
            load_prompt
            run_iteration
            exit 0
            ;;
    esac

    # Default: run loop
    load_prompt
    for ((i=1; i<=max_iterations; i++)); do
        printf '=== Iteration %d/%d ===\n' "$i" "$max_iterations"
        run_iteration
    done
    echo "Max iterations reached."
}

main "$@"
