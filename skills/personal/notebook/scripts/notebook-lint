#!/usr/bin/env -S python3 -I
import argparse
import datetime
import os
import re
import subprocess
import sys
from pathlib import Path
from urllib.parse import unquote

NOTE_TYPES = {"research", "plan", "decision", "grill", "deploy", "review", "report", "prototype", "handoff", "draft"}
NOTE_STATUSES = {"active", "superseded", "done"}
PAGE_STATUSES = {"active", "parked", "done"}
PAGE_SECTIONS = ["State", "Decisions", "Open", "Sources"]
ROOT_ENTRIES = {
    "topics", "inbox", "archive", "_bulk", "scripts", "index.md", "log.md", "lint.md", "AGENTS.md",
    "README.md", "backlog.md", ".gitignore", ".stignore", ".obsidian", ".stfolder", ".git",
}
RAW_SUFFIXES = {".req", ".hdr", ".body", ".tokens"}
MAX_BYTES = 1024 * 1024
STALE_DAYS = 30
INDEX_LINE_MAX = 120

NOTE_NAME = re.compile(r"^(\d{4}-\d{2}-\d{2})-\d{4}-([a-z]+)-[a-z0-9]+(?:-[a-z0-9]+)*\.md$")
FENCE = re.compile(r"^ {0,3}(```|~~~).*?^ {0,3}\1[^\n]*$", re.M | re.S)
INLINE_CODE = re.compile(r"`[^`\n]*`")
WIKILINK = re.compile(r"!?\[\[([^\]\n]+)\]\]")
MD_LINK = re.compile(r"!?\[[^\]\n]*\]\(<?([^)\s>]+)>?\)")
BULK_PATH = re.compile(r"(?<![\w/.-])_bulk/(?!<)[^\s`'\")\]<>]+")
SECTION = re.compile(r"^##\s+(.+?)\s*$", re.M)
RESUME = re.compile(r"^\W*Resume\b[^\n]*?\[\[([^\]|#\n]+)", re.M)


def git(root, *args):
    r = subprocess.run(["git", "-C", str(root), *args], capture_output=True, text=True)
    return r.stdout.splitlines() if r.returncode == 0 else None


def vault_files(root):
    if (root / ".git").exists():
        return sorted(set(git(root, "ls-files", "--cached", "--others", "--exclude-standard") or []))
    files = []
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if d != ".git"]
        rel = Path(dirpath).relative_to(root)
        files += [(rel / f).as_posix() for f in filenames]
    return sorted(files)


def all_paths_on_disk(root):
    paths = set()
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if d != ".git"]
        rel = Path(dirpath).relative_to(root)
        paths.update((rel / f).as_posix() for f in filenames)
    return paths


def frontmatter(text):
    if not text.startswith("---\n"):
        return None
    end = text.find("\n---", 4)
    if end < 0:
        return None
    fields = {}
    for line in text[4:end].splitlines():
        key, sep, value = line.partition(":")
        if sep and not line.startswith((" ", "#")):
            fields[key.strip()] = value.split(" #")[0].strip().strip("\"'")
    return fields


def section(text, name):
    heads = list(SECTION.finditer(text))
    for i, m in enumerate(heads):
        if m.group(1) == name:
            end = heads[i + 1].start() if i + 1 < len(heads) else len(text)
            return text[m.end():end]
    return ""


def link_stems(text):
    return {m.group(1).split("|")[0].split("#")[0].strip().rsplit("/", 1)[-1] for m in WIKILINK.finditer(text)}


def is_binary(path):
    with open(path, "rb") as f:
        return b"\0" in f.read(8192)


def read(path):
    return path.read_text(errors="replace")


class Lint:
    def __init__(self, root):
        self.root = root
        self.findings = []
        self.files = [f for f in vault_files(root) if not f.startswith("archive/")]
        self.disk = all_paths_on_disk(root)
        self.names = {p.rsplit("/", 1)[-1] for p in self.disk}
        self.stems = {n[:-3] for n in self.names if n.endswith(".md")}

    def add(self, code, path, msg):
        self.findings.append((code, path, msg))

    def run(self):
        self.check_root()
        topics = {}
        for rel in self.files:
            path = self.root / rel
            if not path.is_file():
                continue
            parts = rel.split("/")
            self.check_file(rel, path, parts)
            if rel.endswith(".md"):
                self.check_links(rel, read(path))
            if parts[0] == "topics" and len(parts) > 2 and parts[2] != "artifacts":
                topics.setdefault(parts[1], []).append(rel)
        notes = {}
        for slug, rels in topics.items():
            notes[slug] = [r for r in rels if len(r.split("/")) == 3 and r.endswith(".md") and r != f"topics/{slug}/{slug}.md"]
            for rel in notes[slug]:
                self.check_note(rel, slug)
        inbox = [r for r in self.files if r.startswith("inbox/") and r.count("/") == 1 and r.endswith(".md")]
        for rel in inbox:
            self.check_note(rel, "inbox")
        self.check_inbox(inbox)
        pages = {}
        for slug in topics:
            page = self.root / "topics" / slug / f"{slug}.md"
            if not page.is_file():
                self.add("E-page", f"topics/{slug}/", f"no page {slug}.md")
                continue
            pages[slug] = self.check_page(slug, read(page), notes[slug])
        self.check_index(pages)
        return self

    def check_root(self):
        for entry in sorted({f.split("/")[0] + ("/" if "/" in f else "") for f in self.files}):
            if entry.rstrip("/") not in ROOT_ENTRIES:
                self.add("E-root", entry, "unexpected entry at vault root")

    def check_file(self, rel, path, parts):
        name = parts[-1]
        if name == ".DS_Store" or "mdlr-cache" in parts[:-1] or Path(name).suffix in RAW_SUFFIXES:
            self.add("E-raw", rel, "raw capture or cache file")
        if parts[0] in ("topics", "inbox"):
            size = path.stat().st_size
            if size > MAX_BYTES:
                self.add("E-size", rel, f"{size // 1024} KB is over 1 MB; move it to _bulk/")
            elif is_binary(path):
                self.add("E-size", rel, "binary file; move it to _bulk/")

    def check_links(self, rel, text):
        text = FENCE.sub("", text)
        for bulk in BULK_PATH.findall(text):
            bulk = bulk.rstrip(".,;:")
            if not (self.root / bulk).exists():
                self.add("E-link", rel, f"missing {bulk}")
        text = INLINE_CODE.sub("", text)
        for target in sorted(link_stems(text)):
            if target and target not in self.stems and target not in self.names:
                self.add("E-link", rel, f"[[{target}]] does not resolve")
        here = (self.root / rel).parent
        for target in MD_LINK.findall(text):
            target = unquote(target.split("#")[0])
            if not target or re.match(r"^[a-z][a-z0-9+.-]*:", target, re.I) or target.startswith("_bulk/"):
                continue
            if not ((here / target).exists() or (self.root / target.lstrip("/")).exists()):
                self.add("E-link", rel, f"({target}) does not resolve")

    def check_note(self, rel, slug):
        name = rel.rsplit("/", 1)[-1]
        m = NOTE_NAME.match(name)
        if not m or m.group(2) not in NOTE_TYPES:
            self.add("E-name", rel, "name is not YYYY-MM-DD-HHMM-<kind>-<desc>.md with a known kind")
        fm = frontmatter(read(self.root / rel))
        if fm is None:
            self.add("E-front", rel, "no frontmatter")
            return
        if fm.get("type") not in NOTE_TYPES:
            self.add("E-front", rel, f"type {fm.get('type')!r} is not a note type")
        elif m and m.group(2) != fm["type"]:
            self.add("E-front", rel, f"kind {m.group(2)!r} in name does not match type {fm['type']!r}")
        if fm.get("status") not in NOTE_STATUSES:
            self.add("E-front", rel, f"status {fm.get('status')!r} is not active|superseded|done")
        if not fm.get("topic"):
            self.add("E-front", rel, "missing topic")
        elif fm["topic"] != slug:
            self.add("E-front", rel, f"topic {fm['topic']!r} does not match folder {slug!r}")

    def check_inbox(self, inbox):
        by_ticket = {}
        for rel in inbox:
            tickets = (frontmatter(read(self.root / rel)) or {}).get("tickets", "")
            for ticket in filter(None, (t.strip() for t in tickets.strip("[]").split(","))):
                by_ticket.setdefault(ticket, []).append(rel)
        for ticket, rels in sorted(by_ticket.items()):
            if len(rels) > 1:
                self.add("W-inbox", rels[0], f"{len(rels)} inbox notes share {ticket}; promote them to a topic folder")

    def check_page(self, slug, text, notes):
        rel = f"topics/{slug}/{slug}.md"
        fm = frontmatter(text) or {}
        if fm.get("type") != "topic":
            self.add("E-front", rel, "page needs type: topic")
        if fm.get("status") not in PAGE_STATUSES:
            self.add("E-front", rel, f"status {fm.get('status')!r} is not active|parked|done")
        present = set(SECTION.findall(text))
        missing = [s for s in PAGE_SECTIONS if s not in present]
        if missing:
            self.add("E-page", rel, "missing sections: " + ", ".join(missing))
        listed = link_stems(section(text, "Sources"))
        for note in notes:
            stem = note.rsplit("/", 1)[-1][:-3]
            if stem not in listed:
                self.add("W-sources", note, f"not listed in {slug}.md Sources")
        handoffs = []
        for note in notes:
            fm_note = frontmatter(read(self.root / note)) or {}
            if fm_note.get("type") == "handoff" and fm_note.get("status") != "superseded":
                handoffs.append(note.rsplit("/", 1)[-1][:-3])
        resume = RESUME.search(text)
        if handoffs and (not resume or resume.group(1).strip() != max(handoffs)):
            self.add("W-resume", rel, f"Resume should point at [[{max(handoffs)}]]")
        dates = [m.group(1) for n in notes if (m := NOTE_NAME.match(n.rsplit("/", 1)[-1]))]
        if fm.get("status") == "done":
            self.add("W-archive", rel, "status is done; propose archive")
        elif dates:
            age = (datetime.date.today() - datetime.date.fromisoformat(max(dates))).days
            if age > STALE_DAYS:
                self.add("W-archive", rel, f"no new note for {age} days; propose archive")
        return rel

    def check_index(self, pages):
        index = self.root / "index.md"
        text = read(index) if index.is_file() else ""
        linked = link_stems(text)
        for slug in sorted(pages):
            if slug not in linked:
                self.add("W-index", "index.md", f"topic {slug} is missing")
        archived = {p.rsplit("/", 1)[-1][:-3] for p in self.disk if re.match(r"^archive/topics/([^/]+)/\1\.md$", p)}
        root_pages = {p[:-3] for p in self.disk if "/" not in p and p.endswith(".md")}
        for stem in sorted(linked - set(pages) - archived - root_pages):
            if stem in self.stems:
                self.add("W-index", "index.md", f"[[{stem}]] is not a topic page")
        for n, line in enumerate(text.splitlines(), 1):
            if len(line) > INDEX_LINE_MAX:
                self.add("W-index", "index.md", f"line {n} is {len(line)} chars (max {INDEX_LINE_MAX})")


def covers(finding_path, rel):
    return rel == finding_path or (finding_path.endswith("/") and rel.startswith(finding_path))


def main():
    ap = argparse.ArgumentParser(description="Lint the notebook vault.")
    ap.add_argument("--staged", action="store_true", help="check only staged paths; print rejected ones on stdout")
    ap.add_argument("--report", metavar="FILE", help="write findings as Markdown (relative to the vault root)")
    ap.add_argument("--root", type=Path, default=Path(os.environ.get("AI_NOTEBOOK_PATH") or Path.home() / "Notebook"))
    args = ap.parse_args()
    root = args.root.expanduser().resolve()

    findings = Lint(root).run().findings
    rejected = []
    if args.staged:
        staged = git(root, "diff", "--cached", "--name-only", "--diff-filter=ACMR") or []
        findings = [f for f in findings if any(covers(f[1], s) for s in staged)]
        rejected = [s for s in staged if any(f[0].startswith("E-") and covers(f[1], s) for f in findings)]

    lines = [f"{code} {path}: {msg}" for code, path, msg in sorted(findings)]
    errors = sum(code.startswith("E-") for code, _, _ in findings)
    summary = f"{errors} errors, {len(findings) - errors} warnings"
    print("\n".join(lines + [summary]), file=sys.stderr if args.staged else sys.stdout)
    if rejected:
        print("\n".join(rejected))
    if args.report:
        body = "\n".join(f"- `{l}`" for l in lines) or "- none"
        (root / args.report).write_text(f"# Notebook lint\n\n_{datetime.datetime.now():%Y-%m-%d %H:%M}: {summary}_\n\n{body}\n")
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main())
